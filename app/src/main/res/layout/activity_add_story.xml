<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Back button -->
    <TextView
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="←"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:gravity="center"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="স্টোরি যোগ করুন"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- Story Image Preview -->
    <ImageView
        android:id="@+id/iv_story_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@android:drawable/ic_menu_camera"
        android:scaleType="centerCrop"
        android:background="#333333"
        android:contentDescription="story preview"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Select Photo Text (shown over image) -->
    <TextView
        android:id="@+id/tv_select_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📷 ছবি নির্বাচন করুন"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#88000000"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="@id/iv_story_preview"
        app:layout_constraintBottom_toBottomOf="@id/iv_story_preview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom Section -->
    <LinearLayout
        android:id="@+id/bottom_section"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/white"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <!-- Post Button -->
        <Button
            android:id="@+id/btn_post_story"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📤 স্টোরি পোস্ট করুন | POST STORY"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@color/white"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>