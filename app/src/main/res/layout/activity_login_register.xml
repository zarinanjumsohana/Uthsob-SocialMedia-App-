<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top green wave shape -->
        <View
            android:id="@+id/top_bg"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@color/bright_green"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Cloud image -->
        <ImageView
            android:id="@+id/cloud_img" android:layout_width="360dp"
            android:layout_height="80dp"
            android:src="@drawable/splash_bg"
            android:scaleType="centerCrop"
            android:contentDescription="cloud"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Logo Row -->
        <LinearLayout
            android:id="@+id/logo_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="120dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="logo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UTH "
                android:textColor="@color/dark_green"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOB"
                android:textColor="@color/bright_green"
                android:textSize="28sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Bengali headline -->
        <TextView
            android:id="@+id/headline_bn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="সরাসরি বাণিজ্য,\nন্যায্য মূল্য।"
            android:textColor="@color/dark_green"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/logo_row"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- English subheading -->
        <TextView
            android:id="@+id/headline_en"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Direct Trade, Fair Prices."
            android:textColor="@color/gray"
            android:textSize="14sp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/headline_bn"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Description -->
        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="একটি স্বচ্ছ কৃষি বাজারের জন্য কৃষক এবং ব্যবসায়ীদের সংযুক্ত করা।"
            android:textColor="@color/gray"
            android:textSize="13sp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/headline_en"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- LOGIN Button -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="লগইন করুন\nLOGIN"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@drawable/btn_green_solid"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- REGISTER Button -->
        <Button
            android:id="@+id/btn_register"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="নিবন্ধন করুন\nREGISTER"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@drawable/btn_green_outline"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="40dp"
            app:layout_constraintTop_toBottomOf="@id/btn_login"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>