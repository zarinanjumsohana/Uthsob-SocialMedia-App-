<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/dark_green"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="←"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="কৃষক নিবন্ধন"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FARMER REGISTRATION"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Form Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/form_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Name -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="পূর্ণ নাম (FULL NAME)" android:textColor="@color/dark_green"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/et_name" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="যেমন: আব্দুল করিম"
                    android:background="@drawable/bg_input_field" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:inputType="textPersonName"
                    android:textSize="14sp" android:layout_marginBottom="16dp"/>

                <!-- Phone -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ফোন নম্বর (PHONE NUMBER)" android:textColor="@color/dark_green"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/et_phone" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="+880 1XXX XXXXXX"
                    android:background="@drawable/bg_input_field" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:inputType="phone"
                    android:textSize="14sp" android:layout_marginBottom="16dp"/>

                <!-- Location -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="অবস্থান (LOCATION)" android:textColor="@color/dark_green"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/et_location" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="আপনার জেলা লিখুন"
                    android:background="@drawable/bg_input_field" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:inputType="text"
                    android:textSize="14sp" android:layout_marginBottom="16dp"/>

                <!-- Krishok ID -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="কৃষক আইডি (KRISHOK ID)" android:textColor="@color/dark_green"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/et_krishok_id" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="আপনার কৃষক আইডি"
                    android:background="@drawable/bg_input_field" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:inputType="text"
                    android:textSize="14sp" android:layout_marginBottom="16dp"/>

                <!-- National ID -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="জাতীয় পরিচয়পত্র (NATIONAL ID)" android:textColor="@color/dark_green"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/et_national_id" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="১০ বা ১৭ ডিজিটের NID নম্বর"
                    android:background="@drawable/bg_input_field" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:inputType="number"
                    android:textSize="14sp" android:layout_marginBottom="16dp"/>

                <!-- Password -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="পাসওয়ার্ড (PASSWORD)" android:textColor="@color/dark_green"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/et_password" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="কমপক্ষে ৬ অক্ষর"
                    android:background="@drawable/bg_input_field" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:inputType="textPassword"
                    android:textSize="14sp" android:layout_marginBottom="24dp"/>

                <!-- Progress -->
                <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:visibility="gone" android:indeterminateTint="@color/dark_green"
                    android:layout_marginBottom="8dp"/>

                <!-- Submit -->
                <Button android:id="@+id/btn_submit" android:layout_width="match_parent"
                    android:layout_height="56dp" android:text="আবেদন জমা দিন | SUBMIT"
                    android:textColor="@color/white" android:textSize="14sp"
                    android:background="@drawable/btn_green_solid"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>