<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Uthsob3O"
        tools:targetApi="31">

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Uthsob3O.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".activities.LoginRegisterActivity"
            android:exported="false"/>
        <activity android:name=".activities.LoginActivity"
            android:exported="false"/>
        <activity android:name=".activities.RoleSelectionActivity"
            android:exported="false"/>
        <activity android:name=".activities.FarmerRegisterActivity"
            android:exported="false"/>
        <activity android:name=".activities.BusinessmanRegisterActivity"
            android:exported="false"/>
        <activity android:name=".activities.HomeActivity"
            android:exported="false"/>
        <activity android:name=".activities.BidActivity"
            android:exported="false"/>
        <activity android:name=".activities.NotificationActivity"
            android:exported="false"/>
        <activity android:name=".activities.ProfileActivity"
            android:exported="false"/>
        <activity android:name=".activities.AddCropActivity"
            android:exported="false"/>
        <activity android:name=".activities.AddPostActivity"
            android:exported="false"/>
        <activity android:name=".MainActivity"
            android:exported="false"/>
        <activity android:name=".activities.MyCropsActivity" android:exported="false"/>
        <activity android:name=".activities.EditCropActivity" android:exported="false"/>
        <activity android:name=".activities.FarmerProfileActivity" android:exported="false"/>

    </application>
</manifest>